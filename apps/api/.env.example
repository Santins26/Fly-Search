DATABASE_URL=postgres://viagens:viagens@localhost:5432/viagens
PORT=3333
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# "duffel" usa a API real; "mock" gera preços falsos para desenvolver sem token.
# Se ficar vazio: usa duffel quando houver token, senão mock.
FLIGHT_PROVIDER=

# Crie em https://app.duffel.com → Developers → Access tokens (começa com duffel_test_)
DUFFEL_ACCESS_TOKEN=
